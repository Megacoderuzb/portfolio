        "jsonBody": "={{ JSON.stringify({ bookingId: $('Prepare').item.json.booking.bookingId, calendarEventId: $('Create Calendar event + Meet').item.json.id, meetUrl: ($('Create Calendar event + Meet').item.json.hangoutLink || (($('Create Calendar event + Meet').item.json.conferenceData || {}).entryPoints || [{}])[0].uri || '') }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "portfolioCallbackSecret",
          "name": "Portfolio callback secret"
        }
      },
