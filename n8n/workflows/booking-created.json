    {
      "id": "271fc9f2-bc4a-4fd0-9083-03cfff1bb260",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Formats the booking once (Asia/Tashkent). Later nodes read $('Prepare').\nconst { body: b, appUrl, sheetId, ownerTelegramId } = $input.first().json;\nconst v = b.visitor;\nconst zone = 'Asia/Tashkent';\nconst uz = { JOB_OFFER: 'Ish taklifi', FREELANCE: 'Bir martalik loyiha', NETWORKING: 'Networking', OTHER: 'Boshqa' };\nconst en = { JOB_OFFER: 'Job offer', FREELANCE: 'Freelance project', NETWORKING: 'Networking', OTHER: 'Other' };\nconst startsTashkent = DateTime.fromISO(b.startsAt).setZone(zone).toFormat('dd.MM.yyyy HH:mm');\nconst service = b.service ? b.service.title : '';\n\nreturn [{ json: {\n  appUrl, sheetId, ownerTelegramId,\n  booking: b,\n  startsTashkent,\n  createdTashkent: DateTime.now().setZone(zone).toFormat('dd.MM.yyyy HH:mm'),\n  service,\n  event: {\n    summary: 'Consultation: ' + v.name + ' (' + (en[b.purpose] || b.purpose) + ')',\n    description: [\n      'Purpose: ' + (en[b.purpose] || b.purpose),\n      'Service: ' + (service || '—'),\n      'Company: ' + (v.company || '—'),\n      'Telegram: ' + (v.telegram || '—'),\n      'Phone: ' + (v.phone || '—'),\n      'Note: ' + (b.note || '—'),\n      '',\n      'Manage / cancel: ' + b.manageUrl,\n    ].join('\\n'),\n    start: { dateTime: b.startsAt, timeZone: zone },\n    end: { dateTime: b.endsAt, timeZone: zone },\n    attendees: [{ email: v.email, displayName: v.name }],\n    conferenceData: { createRequest: { requestId: b.bookingId, conferenceSolutionKey: { type: 'hangoutsMeet' } } },\n    reminders: { useDefault: false, overrides: [{ method: 'popup', minutes: 30 }, { method: 'popup', minutes: 10 }] },\n  },\n  ownerText: [\n    '🆕 Yangi uchrashuv',\n    '👤 ' + v.name + (v.company ? ' (' + v.company + ')' : ''),\n    '🎯 Maqsad: ' + (uz[b.purpose] || b.purpose),\n    '🧩 Xizmat: ' + (service || '—'),\n    '🕒 ' + startsTashkent + ' (Toshkent)',\n    '📧 ' + [v.email, v.telegram, v.phone].filter(Boolean).join('  '),\n    '📝 ' + (b.note || '—'),\n  ].join('\\n'),\n} }];"
      }
    },
    {
      "id": "b5fd03d2-17ac-41ad-adbc-0d54e7f18c99",
      "name": "Create Calendar event + Meet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "conferenceDataVersion",
              "value": "1"
            },
            {
              "name": "sendUpdates",
              "value": "all"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.event) }}",
        "options": {}
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "googleCalendarAccount",
          "name": "Google Calendar account"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Calendar API directly: conferenceDataVersion=1 creates the Meet link; sendUpdates=all emails the visitor the invite (their confirmation)."
    },
