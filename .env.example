# ---- general
NODE_ENV=development
APP_URL=http://localhost:3000
# public domain in production, e.g. https://abduvaxobov.uz
# Optional split hosts (leave empty in development: everything is served on APP_URL).
# ADMIN_URL: the admin panel gets its own host; the main host then returns 404 for /admin.
ADMIN_URL=
# NEXT_PUBLIC_API_URL: the public API gets its own host (CORS allows only APP_URL). Baked in at BUILD time.
NEXT_PUBLIC_API_URL=

# ---- database / redis (local dev defaults; docker-compose.yml overrides these inside Docker)
POSTGRES_PASSWORD=change-me
# host ports for docker-compose.dev.yml, if 5432 / 6379 are already taken on your machine
# DB_PORT=5435
# REDIS_PORT=6380
# use 127.0.0.1 (not localhost): Node may resolve localhost to ::1 and hit another service
DATABASE_URL=postgresql://portfolio:change-me@127.0.0.1:5432/portfolio
REDIS_URL=redis://127.0.0.1:6379

# ---- admin (single owner)
ADMIN_EMAIL=you@example.com
# generate with `pnpm hash-password` (prints the bcrypt hash base64-encoded: a raw "$2b$…" gets mangled by
# .env / docker compose "$" expansion). A raw bcrypt hash is also accepted where nothing expands "$".
ADMIN_PASSWORD_HASH=
# 32+ random chars; generate: openssl rand -base64 48
SESSION_SECRET=
# salt for hashing visitor IPs
IP_HASH_SALT=

# ---- uploads
RESUME_DIR=./data/resume

# ---- Telegram personal assistant bot
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ---- n8n integration
N8N_BASE_URL=http://localhost:5678
# app -> n8n webhooks (header X-Webhook-Secret)
N8N_WEBHOOK_SECRET=
# n8n -> app callbacks (header X-Callback-Secret)
N8N_CALLBACK_SECRET=
# n8n container config (used by docker-compose)
N8N_HOST=n8n.localhost
N8N_ENCRYPTION_KEY=

# ---- Cloudflare Turnstile (free)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- site contacts (also editable in admin settings)
NEXT_PUBLIC_CONTACT_EMAIL=muhammadjonabduvahobov7701@gmail.com
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/Abduvaxobov_MA
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/muhammadjonabduvahobov
NEXT_PUBLIC_GITHUB_URL=https://github.com/Megacoderuzb
